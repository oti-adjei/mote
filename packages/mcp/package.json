{
  "name": "@usemote/mcp",
  "version": "0.1.1",
  "description": "MCP server for Mote — lets coding agents discover shapes, packs and presets, and generate correct snippets.",
  "license": "MIT",
  "author": {
    "name": "George Heavenson",
    "url": "https://hearvie.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oti-adjei/mote.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://mote.hearvie.dev",
  "bugs": "https://github.com/oti-adjei/mote/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mote-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@usemote/core": "workspace:^0.1.1",
    "@usemote/pack-esports": "workspace:^0.1.1",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
