{
  "name": "@usemote/pack-esports",
  "version": "0.1.0",
  "description": "Esports shape pack for Mote — controllers, trophies, keycaps and 13 more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oti-adjei/mote.git",
    "directory": "packages/pack-esports"
  },
  "homepage": "https://mote.hearvie.dev",
  "bugs": "https://github.com/oti-adjei/mote/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "8 kB"
    }
  ],
  "peerDependencies": {
    "@usemote/core": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@usemote/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
