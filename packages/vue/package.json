{
  "name": "@usemote/vue",
  "version": "0.1.0",
  "description": "Vue 3 component for Mote — deterministic floating-shape background fields.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oti-adjei/mote.git",
    "directory": "packages/vue"
  },
  "homepage": "https://mote.hearvie.dev",
  "bugs": "https://github.com/oti-adjei/mote/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "3 kB"
    }
  ],
  "peerDependencies": {
    "@usemote/core": "workspace:^0.1.0",
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@usemote/core": "workspace:*",
    "vue": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/server-renderer": "^3.5.0",
    "happy-dom": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
