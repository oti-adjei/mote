{
  "name": "@usemote/svelte",
  "version": "0.1.1",
  "description": "Svelte action for Mote — deterministic floating-shape background fields.",
  "license": "MIT",
  "author": {
    "name": "George Heavenson",
    "url": "https://hearvie.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oti-adjei/mote.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://mote.hearvie.dev",
  "bugs": "https://github.com/oti-adjei/mote/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 kB"
    }
  ],
  "peerDependencies": {
    "@usemote/core": "workspace:^0.1.1",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@usemote/core": "workspace:*",
    "happy-dom": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
